meta {
  name: Show Collection
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/collection/{{collectionSlug}}
  body: none
  auth: none
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("response has collection data", function() {
    expect(res.getBody()).to.have.property("data");
    expect(res.getBody().data).to.have.property("slug");
    expect(res.getBody().data).to.have.property("photographies");
  });
}
