APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8001
APP_PORT=8001

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_DRIVER=
DB_CONNECTION=
DB_HOST=
DB_PORT=
FORWARD_DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1
L5_SWAGGER_GENERATE_ALWAYS=false

# Origines CORS autorisées (séparées par des virgules, * pour tout autoriser)
CORS_ALLOWED_ORIGINS=*

# Proxies de confiance pour X-Forwarded-* (ex: * sur Railway, ou IPs séparées par des virgules)
TRUSTED_PROXIES=

SCALEWAY_REGION=
SCALEWAY_ENDPOINT=
SCALEWAY_BUCKET=
SCALEWAY_KEY=
SCALEWAY_SECRET=
OBJECT_STORAGE_PUBLIC_URL=

# Token GitHub à portée minimale (lecture seule des repos nécessaires)
GITHUB_TOKEN=
GITHUB_USERNAME=

GOOGLE_SERVICE_ACCOUNT_CREDENTIALS=storage/app/google/search-console-service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=
SEARCH_CONSOLE_CACHE_TTL=3600
SEARCH_CONSOLE_RENAUDFRADIN_PROPERTY=sc-domain:example.com
SEARCH_CONSOLE_RENAUDFRADINPHOTO_PROPERTY=https://example.com/

# Instagram Login : copier depuis Meta > Instagram > API setup with Instagram login >
# Business login settings (Instagram App ID + Instagram App Secret).
# Ne pas utiliser l’App ID / secret de Paramètres de l’app > Général (erreur « Invalid platform app »).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Alias supportés : INSTAGRAM_CLIENT_ID / INSTAGRAM_CLIENT_SECRET
INSTAGRAM_REDIRECT_URI=${APP_URL}/instagram/callback
INSTAGRAM_GRAPH_VERSION=v25.0
INSTAGRAM_GRAPH_HOST=https://graph.instagram.com
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_manage_insights

SANCTUM_TOKEN_EXPIRATION=525600
